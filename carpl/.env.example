# Prostate MRI CARPL stack - environment configuration.
# Copy to .env next to docker-compose-carpl.yml and adjust.  Every value
# below is the default used when the variable is unset.

# ---- Release / host -------------------------------------------------------
# Image tag loaded from the release tar (docker load -i images.tar).
VERSION=1.0.0
# Host user/group that owns ./data (all services run as this user, so no
# root-owned patient files accumulate on the host).  Use `id -u` / `id -g`.
PUID=1000
PGID=1000
LOG_LEVEL=INFO

# ---- Inbound: CARPL -> dicom-listener (Storage SCP) ------------------------
# Must match the CARPL algorithm registration ("ae_title", "port").
DICOM_AE=PROSTATE_AI
DICOM_PORT=11112
# Reject associations addressed to another called AE title.
REQUIRE_CALLED_AET=true
# Optional comma-separated allowlist of CARPL calling AE titles (empty = any).
ALLOWED_CALLING_AES=
# Only these modalities are stored; others are acknowledged and dropped.
ACCEPT_MODALITIES=MR
# A study is dispatched after this many seconds without new instances and
# with no open association (CARPL guide 4: study completeness).
STUDY_QUIET_SECONDS=60
# Refuse new instances (status 0xA700) when free space drops below this.
MIN_FREE_GB=20
# Identical resends within this window are skipped once queued/delivered.
DEDUP_TTL_SECONDS=86400
# Received study stores are purged this long after their last activity.
STUDY_RETENTION_HOURS=6

# ---- ai-worker ------------------------------------------------------------
# Refuse to process jobs without a CUDA GPU (prevents silent 30+ min CPU runs).
REQUIRE_GPU=true
MIN_GPU_MEMORY_GB=11.5
# Optional checksum manifest written by scripts/package_models.py, mounted
# from ./config (it must NOT be inside ./models).
MODEL_MANIFEST=/config/deployment_manifest.json
REQUIRE_MODEL_MANIFEST=false
JOB_TIMEOUT_SECONDS=900
MAX_JOB_ATTEMPTS=3
# When more than one series matches a T2/ADC/HIGHB rule, the pipeline keeps
# its existing first-match behaviour.  "send" (default) returns results as
# usual; "hold" keeps them for manual review.  Candidates are always logged.
AMBIGUOUS_SELECTION_POLICY=send
# Return the truthful zero-ROI RTSTRUCT + SR when no prostate is detected.
SEND_EMPTY_RESULTS=true
DELIVERED_RETENTION_HOURS=24
FAILED_RETENTION_DAYS=7

# ---- Outbound: dicom-sender -> CARPL result receiver -----------------------
# SGH RAPIER values used by the CXR-BMD stack.  "CARPL-RECIEVE" is spelled
# exactly as configured on the CARPL side.
CALLING_AE=PROSTATE_AI
DEST_AE=CARPL-RECIEVE
DEST_HOST=rapier-orthanc-prefect
DEST_PORT=4242
SEND_MAX_ATTEMPTS=8
SEND_BACKOFF_BASE_SECONDS=30
SEND_BACKOFF_MAX_SECONDS=900
# Never re-encode results unless CARPL rejects the file's transfer syntax.
SEND_ALLOW_TRANSCODE=false
